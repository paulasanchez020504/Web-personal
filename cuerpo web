  <script>
        lucide.createIcons();

        let activeExp = null;

        function toggleExp(index) {
            const detail = document.getElementById('detail-' + index);
            const chevron = document.getElementById('chevron-' + index);
            const card = document.querySelector('[data-template-id="exp-' + index + '"]');

            // If clicking the currently active one, close it
            if (activeExp === index) {
                detail.classList.remove('open');
                chevron.classList.remove('rotated');
                card.classList.remove('active');
                activeExp = null;
                return;
            }

            // Close previously active
            if (activeExp !== null) {
                const prevDetail = document.getElementById('detail-' + activeExp);
                const prevChevron = document.getElementById('chevron-' + activeExp);
                const prevCard = document.querySelector('[data-template-id="exp-' + activeExp + '"]');
                if (prevDetail) prevDetail.classList.remove('open');
                if (prevChevron) prevChevron.classList.remove('rotated');
                if (prevCard) prevCard.classList.remove('active');
            }

            // Open new
            detail.classList.add('open');
            chevron.classList.add('rotated');
            card.classList.add('active');
            activeExp = index;
        }
    </script>
 
